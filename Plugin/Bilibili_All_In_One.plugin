#!name = 哔哩哔哩增强 (All-in-One)
#!desc = 融合最新 ProtoBuf 纯净去广告、空降助手 (SponsorBlock)、直播间净化、极简双底栏（首页+我的）与港澳台全区番剧解锁
#!author = kokoryh, VirgilClyne, GoldenLoaf24h
#!homepage = https://github.com/GoldenLoaf24h/Loon
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Bilibili.png
#!system = iOS,iPadOS
#!system_version = 15.0
#!loon_version = 3.3.8(932)
#!tag = 哔哩哔哩,去广告,增强

[Argument]
# === 1. 核心去广告与空降助手 ===
displayUpList = select,"auto","show","hide",tag=[动态] 最常访问展示方式,desc=auto：仅有直播时显示；show：始终显示；hide：始终隐藏
purifyComment = switch,true,tag=[评论区] 过滤置顶评论广告,desc=移除评论区顶部的广告与商品推广卡片
optimizeRequest = switch,true,tag=[网络] 优化评论区请求,desc=精简评论区下行数据体积，提升加载速度
sponsorBlock = switch,true,tag=[视频] 启用空降助手,desc=自动跳过视频内嵌的片头/恰饭广告片段
logLevel = select,"off","error","warn","info","debug",tag=[调试] 脚本日志等级,desc=控制控制台日志输出详略程度

# === 2. 全球模式与番剧解锁 (Global) ===
ForceHost = select,"1","0","2",tag=[全球] 强制CDN主机名类型,desc=1: HTTP域名(推荐); 0: IP远端解析; 2: HTTPS域名
Locales = input,"CHN,HKG,TWN",tag=[全球] 启用自动识别与换线地区,desc=启用全区识别与分流的地区列表
Proxies.CHN = input,"DIRECT",tag=[🇨🇳中国大陆] 代理策略名称,desc=大陆直连策略名称
Proxies.HKG = input,"香港节点",tag=[🇭🇰中国香港] 代理策略名称,desc=请填入您 Loon 配置文件中的香港代理策略组名称
Proxies.MAC = input,"DIRECT",tag=[🇲🇴中国澳门] 代理策略名称,desc=澳门代理策略名称
Proxies.TWN = input,"台湾节点",tag=[🇹🇼中国台湾] 代理策略名称,desc=请填入您 Loon 配置文件中的台湾代理策略组名称
Storage = select,"Argument","PersistentStore","database",tag=[全球] 配置存储类型,desc=默认 Argument 优先

[Rule]
DOMAIN,bsbsb.top,PROXY
DOMAIN,api.biliapi.com,REJECT
DOMAIN,app.biliapi.com,REJECT
DOMAIN,api.biliapi.net,REJECT
DOMAIN,app.biliapi.net,REJECT
AND,((DOMAIN-SUFFIX,chat.bilibili.com), (OR,((DOMAIN-KEYWORD,stun), (DOMAIN-KEYWORD,tracker), (DOMAIN-KEYWORD,p2p)))),REJECT

[Rewrite]
# 直播间带货与游戏推广拦截
^https://api.live.bilibili.com/xlive/e-commerce-interface/v1/ecommerce-user/get_shopping_info? reject-dict
^https://line3-h5-mobile-api.biligame.com/game/live/large_card_material? reject-dict

# 开屏广告秒开与活动弹窗 Mock
^https://app.bilibili.com/x/v2/splash/list? mock-response-body data-type=text status-code=200 data="{\"code\":0,\"message\":\"OK\",\"ttl\":1,\"data\":{\"max_time\":0,\"min_interval\":31536000,\"pull_interval\":31536000,\"keep_ids\":[],\"show\":[],\"list\":[{}],\"splash_request_id\":\"\"}}"
^https://ap[ip].bilibili.com/x/(resource/(top/activity|patch/tab(/v2)?)|v2/search/square|vip/ads/materials)? mock-response-body data-type=text status-code=200 data="{\"code\":-404,\"message\":\"-404\",\"ttl\":1,\"data\":null}"
^https://api.bilibili.com/pgc/activity/deliver/material/receive? mock-response-body data-type=text status-code=200 data="{\"code\":0,\"data\":{\"closeType\":\"close_win\",\"container\":[],\"showTime\":\"\"},\"message\":\"success\"}"
^https://grpc.biliapi.net/bilibili.app.interface.v1.Teenagers/ModeStatus$ mock-response-body data-type=text data="AAAAABMKEQgCEgl0ZWVuYWdlcnMgAioA" mock-data-is-base64=true
^https://grpc.biliapi.net/bilibili.app.interface.v1.Search/DefaultWords$ mock-response-body data-type=text data="AAAAACEaHeaQnOe0ouinhumikeOAgeeVquWJp+aIlnVw5Li7KAE=" mock-data-is-base64=true
^https://grpc.biliapi.net/bilibili.app.(view.v1.View/TFInfo|viewunite.v1.View/(PlayPause|ViewEndPage))$ mock-response-body data-type=text data="AAAAAAA=" mock-data-is-base64=true
^https://grpc.biliapi.net/bilibili.app.(interface.v1.(Teenagers/ModeStatus|Search/DefaultWords)|view.v1.View/TFInfo|viewunite.v1.View/(PlayPause|ViewEndPage))$ response-header-add grpc-status 0

# P2P 与 Tracker 净化
^https://api.live.bilibili.com/xlive/open-interface/v2/tracker/conf? response-body-json-jq '.data.domains=["wss://tracker.chat.bilibili.com"]'
^https://api.bilibili.com/x/pd-proxy/tracker? response-body-json-jq '.data[][]?="stun.chat.bilibili.com:3478"'
^https://api.bilibili.com/pgc/view/v2/app/season? response-body-json-jq 'del(.data.payment)'
^https://api.bilibili.com/pgc/page/channel? response-body-json-jq '.data.modules |= map(select(.type != "TIP") | if .type == "BANNER" then .module_data.items |= map(select(.url | startswith("https://www.bilibili.com/blackboard/era/") | not)) else . end)'

# UI 精简：内联极速 JQ（彻底剔除会员购、发布、动态，仅保留极简：首页、我的）
^https://app.bilibili.com/x/resource/show/skin? response-body-json-del data.common_equip
^https://app.bilibili.com/x/resource/show/tab/v2? response-body-json-jq '.data.tab = [{pos: 1, id: 731, name: "直播", tab_id: "直播tab", uri: "bilibili://live/home"}, {pos: 2, id: 477, name: "推荐", tab_id: "推荐tab", uri: "bilibili://pegasus/promo", default_selected: 1}, {pos: 3, id: 478, name: "热门", tab_id: "热门tab", uri: "bilibili://pegasus/hottopic"}, {pos: 4, id: 3502, name: "动画", tab_id: "bangumi", uri: "bilibili://pgc/bangumi_v2"}, {pos: 5, id: 3503, name: "影视", tab_id: "film", uri: "bilibili://pgc/cinema_v2"}] | .data.top = [{pos: 1, id: 176, name: "消息", tab_id: "消息Top", uri: "bilibili://link/im_home", icon: "http://i0.hdslb.com/bfs/archive/d43047538e72c9ed8fd8e4e34415fbe3a4f632cb.png"}] | .data.bottom = [{pos: 1, id: 177, name: "首页", tab_id: "home", uri: "bilibili://main/home/", icon: "http://i0.hdslb.com/bfs/archive/63d7ee88d471786c1af45af86e8cb7f607edf91b.png", icon_selected: "http://i0.hdslb.com/bfs/archive/e5106aa688dc729e7f0eafcbb80317feb54a43bd.png"}, {pos: 2, id: 181, name: "我的", tab_id: "我的Bottom", uri: "bilibili://user_center/", icon: "http://i0.hdslb.com/bfs/archive/4b0b2c49ffeb4f0c2e6a4cceebeef0aab1c53fe1.png", icon_selected: "http://i0.hdslb.com/bfs/archive/a54a8009116cb896e64ef14dcf50e5cade401e00.png"}]'
^https://app.bilibili.com/x/v2/splash/(show|event/list2)? response-body-json-jq '.data |= with_entries(if .key | IN("show", "event_list") then .value = [] else . end)'
^https://app.bilibili.com/x/v2/account/myinfo? response-body-json-jq '.data.vip |= if . != null and .status == 0 then . + { status: 1, type: 2, due_date: 9005270400000, role: 15 } else . end'

[Script]
# === 1. 全球模式与番剧解锁 (BiliUniverse Global 全套 gRPC/REST 搜索与播放解锁) ===
http-request ^https?://www.bilibili.com/bangumi/play/(ss|ep)d+/? requires-body=true, script-path=https://raw.githubusercontent.com/GoldenLoaf24h/Loon/main/Script/global_request.bundle.js, tag=BiliBili.Global.bangumi.play.html, argument=[{ForceHost},{Locales},{Proxies.CHN},{Proxies.HKG},{Proxies.MAC},{Proxies.TWN},{Storage},{LogLevel}]
http-request ^https?://(grpc|app).bili(bili.com|api.net)/bilibili.polymer.app.search.v1.Search/(SearchAll|SearchByType)$ requires-body=true, binary-body-mode=true, script-path=https://raw.githubusercontent.com/GoldenLoaf24h/Loon/main/Script/global_request.bundle.js, tag=BiliBili.Global.search.grpc, argument=[{ForceHost},{Locales},{Proxies.CHN},{Proxies.HKG},{Proxies.MAC},{Proxies.TWN},{Storage},{LogLevel}]
http-request ^https?://app.bili(bili.com|api.net)/x/v2/search(/type)?? script-path=https://raw.githubusercontent.com/GoldenLoaf24h/Loon/main/Script/global_request.bundle.js, tag=BiliBili.Global.search.app, argument=[{ForceHost},{Locales},{Proxies.CHN},{Proxies.HKG},{Proxies.MAC},{Proxies.TWN},{Storage},{LogLevel}]
http-request ^https?://api.bili(bili.com|api.net)/x/web-interface/wbi/search/(all/v2|type)? script-path=https://raw.githubusercontent.com/GoldenLoaf24h/Loon/main/Script/global_request.bundle.js, tag=BiliBili.Global.search.wbi, argument=[{ForceHost},{Locales},{Proxies.CHN},{Proxies.HKG},{Proxies.MAC},{Proxies.TWN},{Storage},{LogLevel}]
http-request ^https?://api.bili(bili.com|api.net)/pgc/view/(v2/app|web|pc)/season? script-path=https://raw.githubusercontent.com/GoldenLoaf24h/Loon/main/Script/global_request.bundle.js, tag=BiliBili.Global.season.req, argument=[{ForceHost},{Locales},{Proxies.CHN},{Proxies.HKG},{Proxies.MAC},{Proxies.TWN},{Storage},{LogLevel}]
http-response ^https?://api.bili(bili.com|api.net)/pgc/view/(v2/app|web|pc)/season? requires-body=true, script-path=https://raw.githubusercontent.com/GoldenLoaf24h/Loon/main/Script/global_response.bundle.js, tag=BiliBili.Global.season.resp, argument=[{ForceHost},{Locales},{Proxies.CHN},{Proxies.HKG},{Proxies.MAC},{Proxies.TWN},{Storage},{LogLevel}]
http-response ^https?://api.bili(bili.com|api.net)/pgc/view/(v2/app|web|pc)/ep/list? requires-body=true, script-path=https://raw.githubusercontent.com/GoldenLoaf24h/Loon/main/Script/global_response.bundle.js, tag=BiliBili.Global.ep.list, argument=[{ForceHost},{Locales},{Proxies.CHN},{Proxies.HKG},{Proxies.MAC},{Proxies.TWN},{Storage},{LogLevel}]
http-request ^https?://(grpc|app).bili(bili.com|api.net)/bilibili.pgc.gateway.player.v2.PlayURL/PlayView$ requires-body=true, binary-body-mode=true, script-path=https://raw.githubusercontent.com/GoldenLoaf24h/Loon/main/Script/global_request.bundle.js, tag=BiliBili.Global.player.grpc, argument=[{ForceHost},{Locales},{Proxies.CHN},{Proxies.HKG},{Proxies.MAC},{Proxies.TWN},{Storage},{LogLevel}]
http-request ^https?://api.bili(bili.com|api.net)/pgc/player/(api|web)/playurl(/html5)?? script-path=https://raw.githubusercontent.com/GoldenLoaf24h/Loon/main/Script/global_request.bundle.js, tag=BiliBili.Global.player.playurl, argument=[{ForceHost},{Locales},{Proxies.CHN},{Proxies.HKG},{Proxies.MAC},{Proxies.TWN},{Storage},{LogLevel}]

# === 2. 可莉/Sparkle 核心去广告与空降助手 (实时跟随 master 分支) ===
http-request ^https://(grpc.biliapi.net|app.bilibili.com)/bilibili.community\.service\.dm\.v1\.DM/DmSegMobile$ script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.protobuf.request.js, argument=[{logLevel}], requires-body=true, binary-body-mode=true, timeout=10, enable={sponsorBlock}, tag=bilibili.airborne
http-request ^https://(grpc.biliapi.net|app.bilibili.com)/bilibili.(app.viewunite.v1.View/View|main.community.reply.v1.Reply/MainList)$ script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.protobuf.request.js, argument=[{purifyComment}, {logLevel}], requires-body=true, binary-body-mode=true, timeout=10, enable={optimizeRequest}, tag=bilibili.request
http-response ^https://api.live.bilibili.com/xlive/(app-interface/v2/index/feed|app-room/v1/index/getInfoBy(Room|User))? script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.json.js, requires-body=true, tag=bilibili.live
http-response ^https://www.bilibili.com/blackboard/era/.+.html? script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/webpage.bilibili.js, requires-body=true, tag=bilibili.webpage
http-response ^https://(grpc.biliapi.net|app.bilibili.com)/bilibili.(app.(show.v1.Popular/Index|dynamic.v2.Dynamic/DynAll|view(unite)?.v1.View/(View|ViewProgress|RelatesFeed|AIRelateAsync)|playurl.v1.PlayURL/PlayView|playerunite.v1.Player/PlayViewUnite)|community.service.dm.v1.DM/DmView|main.community.reply.v1.Reply/MainList)$ script-path=https://raw.githubusercontent.com/kokoryh/Sparkle/refs/heads/master/dist/bilibili.protobuf.response.js, argument=[{displayUpList}, {purifyComment}, {sponsorBlock}, {logLevel}], requires-body=true, binary-body-mode=true, tag=bilibili.protobuf

[Mitm]
hostname = www.bilibili.com, app.bilibili.com, app.biliapi.net, search.bilibili.com, api.bilibili.com, api.global.bilibili.com, api.biliapi.net, grpc.biliapi.net, api.live.bilibili.com, line3-h5-mobile-api.biligame.com
h2 = true
